<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="500.0" style="-fx-background-color: #f5e8d8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="HistoryController">
    <children>
        <Label layoutX="221.0" layoutY="20.0" text="History" style="-fx-font-size: 24; -fx-font-weight: bold;" />
        <Button fx:id="closeButton" layoutX="450.0" layoutY="20.0" mnemonicParsing="false" text="X" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;"/>
        <VBox layoutX="25.0" layoutY="60.0" prefHeight="500.0" prefWidth="450.0" spacing="10.0">
            <children>
                <TextArea fx:id="historyTextArea" editable="false" prefHeight="500.0" prefWidth="450.0" wrapText="true" />
            </children>
        </VBox>
    </children>
</AnchorPane>
